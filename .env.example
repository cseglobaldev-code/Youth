# Y.O.U — public Vite environment template
# Copy to `.env.local` for local development.
# Every VITE_* value is exposed in the browser bundle.

# Local direct Strapi API: http://localhost:1337
VITE_STRAPI_API_URL=http://localhost:1337

# Deprecated; keep empty. Use the Cloudflare API proxy in production.
VITE_STRAPI_API_TOKEN=
