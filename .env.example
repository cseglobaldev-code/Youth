# =============================================================================
# Y.O.U — Vite environment template
# =============================================================================
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored. Anything starting with `VITE_` is exposed to the browser bundle,
# so NEVER put server-only secrets (APP_KEYS, JWT, Cloudinary, DB URL, etc.)
# in this file.
# =============================================================================

# Strapi REST base URL — no trailing slash.
# Local dev:  http://localhost:1337
# Production: https://api.your-domain.tld
VITE_STRAPI_API_URL=http://localhost:1337

# Optional read-only public API token (Strapi → Settings → API Tokens → type:
# "Read-only", "Custom" — restrict to content routes). Leave empty for fully
# public content. Leave empty during local development until tokens are set.
VITE_STRAPI_API_TOKEN=